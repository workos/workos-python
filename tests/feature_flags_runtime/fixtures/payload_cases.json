{
  "description": "Whole-payload validation. valid=false means the payload is rejected and a runtime client keeps its last good configuration. divergence records where Node 12 or .NET 6.6 answers differently.",
  "format": 1,
  "cases": [
    {
      "name": "a populated v2 payload",
      "source": "workos-node src/feature-flags/runtime-client-rules.spec.ts",
      "payload": {
        "version": 2,
        "flags": {
          "flag": {
            "slug": "flag",
            "enabled": true,
            "default_value": true,
            "off_value": false,
            "rules": [
              {
                "id": "rule_org",
                "kind": "conditions",
                "value": false,
                "conditions": [
                  {
                    "target_type": "organization",
                    "operator": "one_of",
                    "values": [
                      "org_1"
                    ]
                  }
                ]
              },
              {
                "id": "rule_user",
                "kind": "conditions",
                "value": true,
                "conditions": [
                  {
                    "target_type": "user",
                    "operator": "one_of",
                    "values": [
                      "user_1"
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "valid": true
    },
