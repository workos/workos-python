{
  "description": "Evaluation context validation. targets is what remains after invalid entries are ignored; warns says whether a warning is logged. Validation never raises.",
  "format": 1,
  "flag": {
    "slug": "flag",
    "enabled": true,
    "default_value": false,
    "off_value": false,
    "rules": [
      {
        "id": "r1",
        "kind": "conditions",
        "value": true,
        "conditions": [
          {
            "target_type": "workspace",
            "operator": "one_of",
            "values": [
              "ws_1"
            ]
          }
        ]
      },
      {
        "id": "r2",
        "kind": "conditions",
        "value": true,
        "conditions": [
          {
            "target_type": "user",
            "operator": "one_of",
            "values": [
              "user_1"
            ]
          }
        ]
      }
    ]
  },
  "cases": [
    {
      "name": "a valid custom target",
      "context": {
        "workspace": "ws_1"
      },
      "targets": {
        "workspace": "ws_1"
      },
      "warns": false
    },
    {
      "name": "built-in types are plain keys",
      "context": {
        "user": "user_1",
        "organization": "org_1"
      },
      "targets": {
        "user": "user_1",
        "organization": "org_1"
      },
      "warns": false
    },
    {
      "name": "null IDs are skipped silently",
      "context": {
        "user": null,
        "workspace": "ws_1"
      },
      "targets": {
        "workspace": "ws_1"
      },
      "warns": false
    },
    {
      "name": "an uppercase type is ignored",
      "context": {
        "Workspace": "ws_1"
      },
      "targets": {},
      "warns": true
    },
    {
      "name": "a type starting with a digit is ignored",
      "context": {
        "1workspace": "ws_1"
      },
      "targets": {},
      "warns": true
    },
    {
      "name": "a 65-character type is ignored",
