      "targets": {},
      "warns": true
    },
    {
      "name": "a dot-dot ID is ignored",
      "context": {
        "workspace": ".."
      },
      "targets": {},
      "warns": true
    },
    {
      "name": "an ID with a space is ignored",
      "context": {
        "workspace": "ws 1"
      },
      "targets": {},
      "warns": true
    },
    {
      "name": "an ID with a trailing newline is ignored",
