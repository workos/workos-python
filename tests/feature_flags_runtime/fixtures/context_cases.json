      },
      "targets": {},
      "warns": true
    },
    {
      "name": "a 64-character type is accepted",
      "context": {
        "wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww": "ws_1"
      },
      "targets": {
        "wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww": "ws_1"
      },
      "warns": false
    },
    {
